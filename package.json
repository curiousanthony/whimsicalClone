{
  "name": "whimsical-clone",
  "productName": "Whimsical Clone",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first macOS desktop clone of Whimsical: boards, flowcharts, mind maps, wireframes, docs and freehand drawing saved as plain files.",
  "author": "Anthony Russo",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:sync": "node scripts/sync-locales.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@floating-ui/react": "^0.27.20",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "^3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-details": "3.31.4",
    "@tiptap/extension-drag-handle": "3.31.4",
    "@tiptap/extension-drag-handle-react": "3.31.4",
    "@tiptap/extension-emoji": "3.31.4",
    "@tiptap/extension-file-handler": "3.31.4",
    "@tiptap/extension-floating-menu": "^3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "immer": "^11.1.21",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.52.0",
    "nanoid": "^5.0.0",
    "perfect-freehand": "^1.2.3",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.16",
    "tiptap-markdown": "^0.9.0",
    "use-sync-external-store": "^1.2.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.1",
    "@types/rbush": "^4.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
